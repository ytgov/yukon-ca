{
    "name": "evolvingweb/test",
    "description": "Yukon",
    "type": "project",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^2.0",
        "drupal/addtoany": "^2.0",
        "drupal/admin_toolbar": "^3.3",
        "drupal/ajax_comments": "1.x-dev@dev",
        "drupal/allowed_formats": "^3.0",
        "drupal/anchor_link": "^3.0",
        "drupal/better_exposed_filters": "^7.1",
        "drupal/bigmenu": "^2.0@RC",
        "drupal/block_class": "^4.0",
        "drupal/ckeditor5_plugin_pack": "^1.5",
        "drupal/ckeditor5_premium_features": "^1.6",
        "drupal/ckeditor_div_manager": "^3.0@alpha",
        "drupal/ckeditor_media_resize": "^1.0",
        "drupal/classy": "^2.0",
        "drupal/color_field": "^3.0",
        "drupal/comment_notify": "1.x-dev@dev",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/config_pages": "^2.18",
        "drupal/config_split": "^2.0",
        "drupal/core-composer-scaffold": "11.4.6",
        "drupal/core-project-message": "11.4.6",
        "drupal/core-recommended": "11.4.6",
        "drupal/cshs": "^4.0",
        "drupal/date_recur": "^3.2",
        "drupal/diff": "^2.1",
        "drupal/ds": "^3.15",
        "drupal/dynamic_entity_reference": "^3.2",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/entity_browser": "^2.17",
        "drupal/entity_embed": "^1.7",
        "drupal/epp": "^1.3",
        "drupal/extlink": "^2.0",
        "drupal/facets": "^3.0",
        "drupal/fences": "^3.0",
        "drupal/field_group": "^4.0",
        "drupal/field_permissions": "^1.1",
        "drupal/filefield_paths": "^1.0@beta",
        "drupal/focal_point": "^2.1",
        "drupal/fontawesome": "^3.0",
        "drupal/geofield": "^10.3",
        "drupal/geophp": "^1.1",
        "drupal/imce": "^3.1",
        "drupal/job_scheduler": "^4.0",
        "drupal/jquery_ui": "^1.8",
        "drupal/jquery_ui_datepicker": "^2.1",
        "drupal/jquery_ui_slider": "^2.1",
        "drupal/jquery_ui_touch_punch": "^1.1",
        "drupal/leaflet": "^10.3",
        "drupal/libraries": "^4.1",
        "drupal/link_attributes": "^2.1",
        "drupal/linkchecker": "^2.0@alpha",
        "drupal/linkit": "^7.0",
        "drupal/mail_safety": "^2.0",
        "drupal/matomo": "^1.23",
        "drupal/maxlength": "^3.2",
        "drupal/media_directories": "3.0.0-rc1",
        "drupal/media_embed_extra": "^1.0@beta",
        "drupal/media_entity_file_replace": "^1.3",
        "drupal/media_file_delete": "^1.3",
        "drupal/media_library_edit": "^3.0",
        "drupal/menu_block": "^1.10",
        "drupal/menu_breadcrumb": "^2.0@alpha",
        "drupal/menu_link_attributes": "^1.3",
        "drupal/metatag": "^2.1",
        "drupal/moderation_scheduler": "^9.1",
        "drupal/noreqnewpass": "^1.4",
        "drupal/openid_connect": "3.0.0-alpha9",
        "drupal/page_manager": "^4.0@RC",
        "drupal/paragraphs": "^1.12",
        "drupal/password_policy": "^4.0",
        "drupal/pathauto": "^1.11",
        "drupal/pathologic": "^2.0@alpha",
        "drupal/redirect": "^1.6",
        "drupal/redis": "^1.6",
        "drupal/responsive_preview": "^2.0",
        "drupal/scheduler": "^2.0@RC",
        "drupal/scheduler_content_moderation_integration": "^3.0",
        "drupal/search_api_attachments": "^10.0",
        "drupal/search_api_solr": "^4.3.12",
        "drupal/search_api_spellcheck": "^4.0",
        "drupal/seckit": "^2.0",
        "drupal/security_review": "^3.1",
        "drupal/selective_better_exposed_filters": "^3.0",
        "drupal/shield": "^1.8",
        "drupal/simple_sitemap": "^4.2",
        "drupal/single_content_sync": "^1.4",
        "drupal/smtp": "^1.2",
        "drupal/stage_file_proxy": "^3.1",
        "drupal/superfish": "^1.7",
        "drupal/svg_image": "^3.0",
        "drupal/time_field": "^2.2",
        "drupal/tmgmt": "^1.15",
        "drupal/token": "^1.11",
        "drupal/twig_field_value": "^2.0",
        "drupal/twig_tweak": "^3.2",
        "drupal/ui_patterns": "^1.2",
        "drupal/username_enumeration_prevention": "^1.3",
        "drupal/video_embed_field": "^3.1",
        "drupal/views_ajax_history": "^1.7",
        "drupal/views_bootstrap": "^5.4",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/views_menu_children_filter": "^4.0",
        "drupal/views_tree": "^3.0",
        "drupal/views_year_filter": "^2.1",
        "drupal/webform": "^6.3",
        "drupal/webform_views": "^5.4",
        "drupal/workbench": "^1.4",
        "drupal/workbench_access": "^2.0",
        "drupal/workbench_email": "^3.0",
        "drush/drush": "*",
        "enshrined/svg-sanitize": "^0.22.0",
        "evolvingweb/blinker_addons": "^2.4",
        "evolvingweb/blinker_core": "^2.0",
        "evolvingweb/glider": "^3.6",
        "mnsami/composer-custom-directory-installer": "^2.1",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "extra": {
        "enable-patching": true,
        "patches": {
            "drupal/core": {
                "3129874 - Base field override for moderation_state added by content_moderation causes config import failure": "https://git.drupalcode.org/project/drupal/-/merge_requests/10304.diff",
                "3264843 - Add support for negating node type(content type) condition for block visibility": "https://www.drupal.org/files/issues/2024-01-08/drupal-3264843-21.patch",
                "3441962 - Call to a member function getSettings() on null in Drupal\\Core\\Field\\FieldConfigBase->getSettings()": "https://git.drupalcode.org/project/drupal/-/merge_requests/8456.diff",
                "3145190 - PHP warnings in array_flip in Drupal\\Core\\Entity\\EntityStorageBase->loadMultiple()": "https://www.drupal.org/files/issues/2023-01-12/3145190-21.patch",
                "3050261 - index.php randomly appears in friendly URLs": "https://www.drupal.org/files/issues/2023-10-12/3050261_htaccess_scaffold.patch"
            },
            "drupal/token": {
                "1614456 - [current-page:query:?] should fall back to empty string": "https://git.drupalcode.org/project/token/-/merge_requests/135.diff"
            },
            "drupal/fontawesome": {
                "3456861 - Empty Settings data unserialize issues with migrated content": "https://git.drupalcode.org/project/fontawesome/-/merge_requests/35.diff"
            },
            "drupal/field_group": {
                "3111107 - Fix translations label/description": "https://www.drupal.org/files/issues/2025-02-25/3111107-59.patch"
            },
            "drupal/datetime_range": {
                "Date time format": "https://www.drupal.org/files/issues/2796151-06.patch"
            },
            "drupal/paragraphs": {
                "Paragraph translation": "https://www.drupal.org/files/issues/2026-06-11/paragraphs_support_asym_translations-2904705-157.patch",
                "Paragraph translation 2": "patches/paragraghs-buttons_do_not_appear_if_translated_node-3125638-15.patch"
            }
        },
        "installer-paths": {
            "docroot/core": [
                "type:drupal-core"
            ],
            "docroot/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "docroot/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "docroot/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "docroot/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "docroot/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "docroot/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "docroot/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "drush/Commands/{$name}": [
                "type:drupal-drush"
            ]
        },
        "drupal-scaffold": {
            "gitignore": false,
            "locations": {
                "web-root": "./docroot"
            },
            "file-mapping": {
                "[web-root]/sites/default/default.services.yml": {
                    "mode": "replace",
                    "path": "docroot/core/assets/scaffold/files/default.services.yml",
                    "overwrite": false
                },
                "[web-root]/sites/default/default.settings.php": {
                    "mode": "replace",
                    "path": "docroot/core/assets/scaffold/files/default.settings.php",
                    "overwrite": false
                },
                "[web-root]/sites/development.services.yml": false
            }
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "merge-plugin": {
            "include": [
                "docroot/modules/contrib/media_directories/composer.libraries.json",
                "docroot/modules/contrib/webform/composer.libraries.json"
            ]
        },
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packagist.ewdev.ca"
        },
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "package",
            "package": {
                "name": "yukon/module_missing_message_fixer",
                "type": "drupal-module",
                "version": "2.x-dev",
                "source": {
                    "url": "https://git.drupalcode.org/project/module_missing_message_fixer",
                    "type": "git",
                    "reference": "2.0.x"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "northernco/ckeditor5-anchor-drupal",
                "version": "0.5.0",
                "type": "drupal-library",
                "dist": {
                    "url": "https://registry.npmjs.org/@northernco/ckeditor5-anchor-drupal/-/ckeditor5-anchor-drupal-0.5.0.tgz",
                    "type": "tar"
                }
            }
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "mnsami/composer-custom-directory-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\PHPUnit\\": "tests/phpunit/src/"
        }
    },
    "scripts": {
        "nuke": [
            "rm -rf vendor composer.lock docroot/core docroot/modules/contrib docroot/profiles/contrib docroot/themes/contrib",
            "@composer clearcache --ansi",
            "@composer install --ansi"
        ]
    },
    "require-dev": {
        "drupal/composer_deploy": "^1.10",
        "drupal/core-dev": "*",
        "drupal/devel": "^5.1",
        "drupal/upgrade_status": "^4.3"
    }
}
