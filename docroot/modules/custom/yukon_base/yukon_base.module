<?php

/**
 * @file
 * Main module file.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\yukon_base\MenuContextualLinks;

/**
 * Implements hook_form_alter().
 */
function yukon_base_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (!in_array($form_id, ['node_multi_step_page_form', 'node_multi_step_page_edit_form'])) {
    return;
  }

  if (!isset($form['field_paragraphs']['widget'])) {
    return;
  }

  $max_steps = 6;

  $item_keys = array_filter(array_keys($form['field_paragraphs']['widget']), fn($key) => is_int($key));
  $item_count = count($item_keys);

  $form['field_paragraphs']['widget']['#cardinality'] = max($item_count, $max_steps);

  if ($item_count >= $max_steps) {
    if (isset($form['field_paragraphs']['widget']['add_more'])) {
      $form['field_paragraphs']['widget']['add_more']['#access'] = FALSE;
    }
    foreach ($item_keys as $key) {
      if (isset($form['field_paragraphs']['widget'][$key]['top']['actions']['dropdown_actions']['duplicate_button'])) {
        $form['field_paragraphs']['widget'][$key]['top']['actions']['dropdown_actions']['duplicate_button']['#access'] = FALSE;
      }
    }
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 */
function yukon_base_form_node_form_alter(&$form, FormStateInterface $form_state) {
  if (!isset($form['revision_log']['widget'][0]['value'])) {
    return;
  }

  // Base the check on the default (live) revision, not the revision the form
  // loaded: a published page with a pending draft loads the draft, which is
  // unpublished. New content and never-published drafts stay optional.
  $entity = $form_state->getFormObject()->getEntity();
  if ($entity->isNew()) {
    return;
  }
  $default = \Drupal::entityTypeManager()->getStorage('node')->load($entity->id());
  $langcode = $entity->language()->getId();
  if ($default && $default->hasTranslation($langcode) && $default->getTranslation($langcode)->isPublished()) {
    $form['revision_log']['widget'][0]['value']['#required'] = TRUE;
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for the event node add and edit forms.
 *
 * Hides the address fields when the event type is "Online". Client-side only:
 * a saved address is kept, so switching the event back to in person or hybrid
 * does not lose it. The event page already hides the Location block for
 * online events.
 */
function yukon_base_form_node_event_form_alter(&$form, FormStateInterface $form_state) {
  $address_fields = [
    'field_building_name',
    'field_event_street_address',
    'field_event_locality_town',
    'field_postal_code',
  ];
  foreach ($address_fields as $field_name) {
    if (isset($form[$field_name])) {
      $form[$field_name]['#states']['invisible'] = [
        ':input[name="field_event_type"]' => ['value' => 'online'],
      ];
    }
  }

  // Same-times checkbox for events with several dates (refs #1184). The
  // checkbox itself sits in the first date row; see the widget alter below.
  if (isset($form['field_event_start_time']['widget'])) {
    $form['field_event_start_time']['widget']['#process'][] = 'yukon_base_event_same_times_process';
    $form['#attached']['library'][] = 'yukon_base/event_same_times';
  }
}

/**
 * Tells whether an event has 2+ dates that all share the same times.
 *
 * Decides if the same-times checkbox starts checked on an existing event.
 */
function yukon_base_event_times_match($event): bool {
  if (!$event->hasField('field_event_start_time')) {
    return FALSE;
  }
  $times = [];
  $rows = 0;
  foreach ($event->get('field_event_start_time') as $item) {
    // The form appends a blank spare row to the items.
    if (!$item->value) {
      continue;
    }
    $rows++;
    $zone = new \DateTimeZone($item->timezone ?: 'America/Whitehorse');
    $row = [];
    foreach (['value', 'end_value'] as $key) {
      $row[] = $item->{$key}
        ? (new \DateTimeImmutable($item->{$key}, new \DateTimeZone('UTC')))->setTimezone($zone)->format('H:i')
        : '';
    }
    $times[implode('-', $row)] = TRUE;
  }
  return $rows > 1 && count($times) === 1;
}

/**
 * Form #process callback: copies the first date's times to the other dates.
 *
 * Runs on the date widget before its children read their input, so the
 * copied values are what gets validated and saved, with or without JavaScript.
 * Each row keeps its own start date; the end date keeps the first row's offset
 * from its start (an overnight event stays overnight).
 */
function yukon_base_event_same_times_process(array &$element, FormStateInterface $form_state, array &$complete_form) {
  $input = $form_state->getUserInput();
  $rows = $input['field_event_start_time'] ?? [];
  if (empty($input['event_same_times']) || !is_array($rows)) {
    return $element;
  }
  $deltas = array_filter(array_keys($rows), 'is_numeric');
  usort($deltas, fn($a, $b) => ($rows[$a]['_weight'] ?? $a) <=> ($rows[$b]['_weight'] ?? $b));
  $first = $rows[array_shift($deltas)] ?? [];
  $offset = 0;
  if (!empty($first['value']['date']) && !empty($first['end_value']['date'])) {
    $offset = (new \DateTimeImmutable($first['value']['date']))->diff(new \DateTimeImmutable($first['end_value']['date']))->format('%r%a');
  }
  foreach ($deltas as $delta) {
    $date = $rows[$delta]['value']['date'] ?? '';
    if ($date === '') {
      continue;
    }
    $input['field_event_start_time'][$delta]['value']['time'] = $first['value']['time'] ?? '';
    $input['field_event_start_time'][$delta]['end_value']['time'] = $first['end_value']['time'] ?? '';
    $input['field_event_start_time'][$delta]['end_value']['date'] = empty($first['end_value']['date'])
      ? ''
      : (new \DateTimeImmutable($date))->modify($offset . ' days')->format('Y-m-d');
    $input['field_event_start_time'][$delta]['timezone'] = $first['timezone'] ?? '';
  }
  $form_state->setUserInput($input);
  return $element;
}

/**
 * Implements hook_form_FORM_ID_alter() for the event node edit form.
 */
function yukon_base_form_node_event_edit_form_alter(&$form, FormStateInterface $form_state) {
  yukon_base_form_node_event_form_alter($form, $form_state);
}

/**
 * Form #process callback: defaults a blank event time zone to Whitehorse.
 *
 * The time zone select has no preselected value, so that blank occurrence rows
 * stay empty. A row with a date or time but no time zone gets Whitehorse here,
 * before the date widget would reject it as missing a time zone. This runs on
 * the row element, ahead of its children's values, and also works for rows
 * added with "Add another item" (form alters do not re-run for those).
 *
 * @see yukon_base_field_widget_single_element_date_recur_basic_widget_form_alter()
 */
function yukon_base_event_time_zone_process(array &$element, FormStateInterface $form_state, array &$complete_form) {
  $input = $form_state->getUserInput();
  $row = NestedArray::getValue($input, $element['#parents']);
  if (is_array($row) && ($row['timezone'] ?? NULL) === ''
    && (!empty($row['value']['date']) || !empty($row['value']['time'])
      || !empty($row['end_value']['date']) || !empty($row['end_value']['time']))) {
    NestedArray::setValue($input, array_merge($element['#parents'], ['timezone']), 'America/Whitehorse');
    $form_state->setUserInput($input);
  }
  return $element;
}

/**
 * Implements hook_field_widget_single_element_WIDGET_TYPE_form_alter().
 *
 * For event dates: drop the seconds from the time inputs and label the blank
 * time zone option as Whitehorse (refs #1184).
 */
function yukon_base_field_widget_single_element_date_recur_basic_widget_form_alter(array &$element, FormStateInterface $form_state, array $context) {
  if ($context['items']->getName() !== 'field_event_start_time') {
    return;
  }

  // The same-times checkbox goes in the first row. Its parents and name are set
  // by hand so its value stays top-level, outside the field's own values.
  if ($context['delta'] === 0) {
    $element['event_same_times'] = [
      '#type' => 'checkbox',
      '#title' => t("Use the first date's start and end times for all dates"),
      '#default_value' => yukon_base_event_times_match($context['items']->getEntity()),
      '#parents' => ['event_same_times'],
      '#name' => 'event_same_times',
      '#weight' => -10,
    ];
  }

  // Editors add one occurrence per date; nobody uses repeat rules. Hide the
  // box rather than disallow rules in the field settings, which would make
  // legacy events that still have a rule fail validation on save. An
  // inaccessible element keeps its saved value, so existing rules survive.
  $element['rrule']['#access'] = FALSE;

  // A one-minute increment makes the browser show hours and minutes only.
  $element['value']['#date_increment'] = 60;
  $element['end_value']['#date_increment'] = 60;

  // Leaving the time zone blank means Whitehorse; see
  // yukon_base_event_time_zone_process(). Preselecting it would make blank rows
  // count as filled in and fail validation.
  $element['timezone']['#empty_option'] = t('Whitehorse (default)');
  $element['#process'][] = 'yukon_base_event_time_zone_process';
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * Gives the menu link form's Parent link the same hierarchical picker as the
 * node form by reusing cshs_menu_link's own transformation.
 */
function yukon_base_form_menu_link_content_menu_link_content_form_alter(&$form, FormStateInterface $form_state) {
  if (!function_exists('cshs_menu_link_form_node_form_alter') || empty($form['menu_parent'])) {
    return;
  }

  // The cshs function expects the node form's element path.
  $wrapper = ['menu' => ['link' => ['menu_parent' => $form['menu_parent']]]];
  cshs_menu_link_form_node_form_alter($wrapper);
  $form['menu_parent'] = $wrapper['menu']['link']['menu_parent'];
}

/**
 * Implements hook_block_view_alter().
 *
 * Makes "Edit menu" on the L2 child menu block open the child menu editor for
 * the current page's menu link.
 */
function yukon_base_block_view_alter(array &$build, $block) {
  if (($build['#id'] ?? NULL) === 'yukonca_glider_l2_child_menu') {
    $build['#pre_render'][] = [MenuContextualLinks::class, 'preRender'];
  }
}

/**
 * Implements hook_views_data_alter().
 */
function yukon_base_views_data_alter(array &$data) {
  $data['views']['exposed_form_selected_filters'] = [
    'title' => t('Exposed form - Selected filters'),
    'help' => '',
    'area' => [
      'id' => 'exposed_form_selected_filters',
    ],
  ];

  // Add custom field to file_usage table.
  $data['file_usage']['media_content_usage'] = [
    'title' => t('Content using this media'),
    'help' => t('Shows the content (nodes) that use this media entity.'),
    'field' => [
      'id' => 'media_content_usage',
    ],
  ];
}
