<?php

/**
 * @file
 * Main module file.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_alter().
 */
function yukon_base_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (!in_array($form_id, ['node_multi_step_page_form', 'node_multi_step_page_edit_form'])) {
    return;
  }

  if (!isset($form['field_paragraphs']['widget'])) {
    return;
  }

  $max_steps = 6;

  $item_keys = array_filter(array_keys($form['field_paragraphs']['widget']), fn($key) => is_int($key));
  $item_count = count($item_keys);

  $form['field_paragraphs']['widget']['#cardinality'] = max($item_count, $max_steps);

  if ($item_count >= $max_steps) {
    if (isset($form['field_paragraphs']['widget']['add_more'])) {
      $form['field_paragraphs']['widget']['add_more']['#access'] = FALSE;
    }
    foreach ($item_keys as $key) {
      if (isset($form['field_paragraphs']['widget'][$key]['top']['actions']['dropdown_actions']['duplicate_button'])) {
        $form['field_paragraphs']['widget'][$key]['top']['actions']['dropdown_actions']['duplicate_button']['#access'] = FALSE;
      }
    }
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 */
function yukon_base_form_node_form_alter(&$form, FormStateInterface $form_state) {
  if (isset($form['revision_log']['widget'][0]['value'])) {
    $form['revision_log']['widget'][0]['value']['#required'] = TRUE;
  }
}

/**
 * Implements hook_views_data_alter().
 */
function yukon_base_views_data_alter(array &$data) {
  $data['views']['exposed_form_selected_filters'] = [
    'title' => t('Exposed form - Selected filters'),
    'help' => '',
    'area' => [
      'id' => 'exposed_form_selected_filters',
    ],
  ];

  // Add custom field to file_usage table.
  $data['file_usage']['media_content_usage'] = [
    'title' => t('Content using this media'),
    'help' => t('Shows the content (nodes) that use this media entity.'),
    'field' => [
      'id' => 'media_content_usage',
    ],
  ];
}
