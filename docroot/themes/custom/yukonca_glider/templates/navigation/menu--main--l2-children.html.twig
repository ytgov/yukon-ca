{#
/**
 * @file
 * Theme override to display a menu.
 *
 * Available variables:
 * - menu_name: The machine name of the menu.
 * - items: A nested list of menu items. Each menu item contains:
 *   - attributes: HTML attributes for the menu item.
 *   - below: The menu item child items.
 *   - title: The menu link title.
 *   - url: The menu link url, instance of \Drupal\Core\Url
 *   - localized_options: Menu link localized options.
 *   - is_expanded: TRUE if the link has visible children within the current
 *     menu tree.
 *   - is_collapsed: TRUE if the link has children within the current menu tree
 *     that are not currently visible.
 *   - in_active_trail: TRUE if the link is in the active trail.
 */
#}
{% import _self as menus %}

{#
  We call a macro which calls itself to render the full tree.
  @see https://twig.symfony.com/doc/1.x/tags/macro.html
#}
{% set section_keys = items|filter(i => i.url.isRouted() and i.url.routeName in ['<nolink>', '<button>'] and i.below)|keys %}
{% if section_keys %}
  <div class="yukon-accordion !mt-0 !pt-0">
    <div class="yukon-accordion__buttons">
      <button class="yukon-accordion__expand">
        <i class="fas fa-square-plus" aria-hidden="true"></i> {{ 'Expand all'|t }}
      </button>
      <button class="yukon-accordion__collapse">
        <i class="fas fa-square-minus" aria-hidden="true"></i> {{ 'Collapse all'|t }}
      </button>
    </div>
  </div>
{% endif %}
<div class="accordion l2-accordion">
  {{ menus.menu_links(items, attributes, 0, section_keys|first) }}
</div>

{% macro menu_links(items, attributes, menu_level, first_section_key) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes.addClass('menu !ml-0') }}>
    {% else %}
      <ul class="menu">
    {% endif %}
    {% for key, item in items %}
      {% set is_placeholder_link = item.url.isRouted() and item.url.routeName in ['<nolink>', '<button>'] %}
      {%
        set classes = [
          'menu-item',
          not is_placeholder_link ? 'mb-5',
          item.in_active_trail ? 'menu-item--active-trail',
        ]
      %}
      <li{{ item.attributes.addClass(classes) }}>
        {% if menu_level == 0 and is_placeholder_link and item.below %}
          {% set section_title %}
            <i class="fas fa-chevron-down l2-accordion__open" aria-hidden="true"></i>
            <span>{{ item.title }}</span>
            <i class="fas fa-plus l2-accordion__closed" aria-hidden="true"></i>
          {% endset %}
          {{ pattern('accordion_item', {
            title: section_title,
            content: menus.menu_links(item.below, attributes, menu_level + 1, first_section_key),
            expanded: key == first_section_key,
          }) }}
        {% else %}
          {{ link(item.title, item.url, { 'class':['font-medium']}) }}
          {% if menu_level > 0 and item.below %}
            {{ menus.menu_links(item.below, attributes, menu_level + 1, first_section_key) }}
          {% endif %}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
