{#
/**
 * @file
 * Theme override to display a menu.
 *
 * Available variables:
 * - menu_name: The machine name of the menu.
 * - items: A nested list of menu items. Each menu item contains:
 *   - attributes: HTML attributes for the menu item.
 *   - below: The menu item child items.
 *   - title: The menu link title.
 *   - url: The menu link url, instance of \Drupal\Core\Url
 *   - localized_options: Menu link localized options.
 *   - is_expanded: TRUE if the link has visible children within the current
 *     menu tree.
 *   - is_collapsed: TRUE if the link has children within the current menu tree
 *     that are not currently visible.
 *   - in_active_trail: TRUE if the link is in the active trail.
 */
#}
{% import _self as menus %}

{#
  We call a macro which calls itself to render the full tree.
  @see https://twig.symfony.com/doc/1.x/tags/macro.html
#}
{% set accordion_group_id = 'l2-children-accordion'|clean_unique_id %}
{{ menus.menu_links(items, attributes, 0, accordion_group_id) }}

{% macro menu_links(items, attributes, menu_level, accordion_group_id) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes.addClass('menu !ml-0').setAttribute('id', accordion_group_id) }}>
    {% else %}
      <ul class="menu">
    {% endif %}
    {% for item in items %}
      {% set is_placeholder_link = item.url.isRouted() and item.url.routeName in ['<nolink>', '<button>'] %}
      {%
        set classes = [
          'menu-item',
          not is_placeholder_link ? 'mb-5',
          item.in_active_trail ? 'menu-item--active-trail',
        ]
      %}
      <li{{ item.attributes.addClass(classes) }}>
        {% if menu_level == 0 and is_placeholder_link and item.below %}
          {{ pattern('collapse_toggle', {
            title: item.title,
            content: menus.menu_links(item.below, attributes, menu_level + 1, accordion_group_id),
            expanded: false,
            parent_id: accordion_group_id,
          }) }}
        {% else %}
          {{ link(item.title, item.url, { 'class':['font-medium']}) }}
          {% if menu_level > 0 and item.below %}
            {{ menus.menu_links(item.below, attributes, menu_level + 1, accordion_group_id) }}
          {% endif %}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
