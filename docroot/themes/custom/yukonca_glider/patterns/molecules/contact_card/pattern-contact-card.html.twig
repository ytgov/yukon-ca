{% set prefix = 'contact-card' %}
{% set classes = [
  prefix,
  prefix ~ '--' ~ variant,
  'leading-none',
  'flex',
  'flex-col',
  'md:block',
] %}

<div {{ attributes.addClass(classes) }}>
  {# Heading and links. Below md the wrapper is display: contents so the
     children can be reordered with the details block: title, instructions,
     details, place, link. From md up it is the original 3-column grid. #}
  <div class="contents md:grid grid-cols-3">
    <div class="order-1 md:order-none col-span-3 md:col-span-2 pt-3 px-3">
      <h2 class="text-h4-mobile md:text-h4 font-medium !pt-0 !my-0">{{ 'Contact us'|t }}</h2>
    </div>
    <div class="{{ prefix }}__place order-4 md:order-none self-center max-w-full md:self-auto">
      {% if place_link %}
        <a href="{{ place_link }}" class="flex items-center justify-center gap-2 !text-white no-underline text-center p-3">
          <i class="fas fa-location-dot" aria-hidden="true"></i>
          <span>{{ place_link_text }}</span>
        </a>
      {% else %}
        <span class="flex items-center justify-center gap-2 text-white text-center p-3">
          <i class="fas fa-location-dot" aria-hidden="true"></i>
          <span>{{ place_link_text }}</span>
        </span>
      {% endif %}
    </div>
    <div class="{{ prefix }}__instructions order-2 md:order-none col-span-3 md:col-span-2 px-3">
      {{ instructional_text }}
    </div>
    {% if link %}
      <div class="{{ prefix }}__link order-5 md:order-none text-center md:text-left p-3">
        {{ link }}
      </div>
    {% endif %}
  </div>
  {# Contact Info #}
  <div class="{{ prefix }}__info order-3 md:order-none px-3 pb-3">
    <div class="{{ prefix }}__details !pl-0">
      {% if email %}
        <div class="{{ prefix }}__detail flex items-center gap-2 mb-2">
          <i class="fas fa-envelope" aria-hidden="true"></i>
          <span class="block font-medium">{{ 'Email'|t }}:</span>
          <span class="block grow">{{ email }}</span>
        </div>
      {% endif %}
      {% if phone %}
        <div class="{{ prefix }}__detail flex items-center gap-2 mb-2">
          <i class="fas fa-phone" aria-hidden="true"></i>
          <span class="block font-medium">{{ 'Phone'|t }}:</span>
          <span class="block grow">{{ phone }}</span>
        </div>
      {% endif %}
      {% if toll_free %}
        <div class="{{ prefix }}__detail flex items-center gap-2 mb-2">
          <i class="fas fa-phone" aria-hidden="true"></i>
          <span class="block font-medium">{{ 'Phone toll free in the Yukon'|t }}:</span>
          <span class="block grow">{{ toll_free }}</span>
        </div>
      {% endif %}
      {% if fax %}
        <div class="{{ prefix }}__detail flex items-center gap-2 mb-2">
          <i class="fas fa-fax" aria-hidden="true"></i>
          <span class="block font-medium">{{ 'Fax'|t }}:</span>
          <span class="block grow">{{ fax }}</span>
        </div>
      {% endif %}
      {% if mail_address %}
        <div class="{{ prefix }}__detail flex items-center gap-2">
          <i class="fas fa-envelope" aria-hidden="true"></i>
          <span class="block font-medium">{{ 'Mail'|t }}:</span>
        </div>
        <span class="block pl-[30px] mb-2">{{ mail_address }}</span>
      {% endif %}
      {% if in_person_address %}
        <div class="{{ prefix }}__detail flex items-center gap-2">
          <i class="fas fa-location-dot" aria-hidden="true"></i>
          <span class="block font-medium">{{ 'In person'|t }}:</span>
        </div>
        <span class="block pl-[30px]">{{ in_person_address }}</span>
      {% endif %}
    </div>
  </div>
</div>
