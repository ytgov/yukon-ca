{% set prefix = 'accordion-item' %}
{% set classes = [
  prefix,
  prefix ~ '--' ~ variant,
] %}

{% if title is not empty %}
    {% set anchor = title|trim|clean_id %}
    {% set item_id = 'accordion-item'|clean_unique_id %}
    {% set is_expanded = expanded|default(false) %}

    <div class="accordion-item">
      <div class="accordion-header" id="{{ item_id }}--header">
        <button class="accordion-button{{ not is_expanded ? ' collapsed' }}" type="button" data-bs-toggle="collapse" data-bs-target="#{{ item_id }}--body" aria-expanded="{{ is_expanded ? 'true' : 'false' }}" aria-controls="{{ item_id }}--body">
          {{ title }}
        </button>
      </div>
      <div id="{{ item_id }}--body" class="accordion-collapse collapse{{ is_expanded ? ' show' }}" aria-labelledby="{{ item_id }}--header">
        <div class="accordion-body">
          {{ content }}
        </div>
      </div>
    </div>
{% endif %}